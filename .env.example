LA_EVENT_STORE_PATH=./data/events.ndjson
LA_NEO4J_URI=bolt://localhost:7687
LA_NEO4J_USER=neo4j
LA_NEO4J_PASSWORD=livingarchive
LA_QDRANT_URL=http://localhost:6333
LA_QDRANT_COLLECTION=theses
LA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LA_OLLAMA_HOST=http://localhost:11434
LA_OLLAMA_MODEL=deepseek-r1:1.5b
LA_ANTHROPIC_API_KEY=
LA_REQUIRE_CONSENT=true
LA_AUDIT_LOG_PATH=./data/audit.ndjson

# Web interface address, used for DOI landing pages and agent links.
LA_PUBLIC_URL=
# Curator token for metadata edits and DOIs (unset disables them).
LA_CURATOR_TOKEN=
# DataCite. Test system by default; production is https://api.datacite.org
LA_DATACITE_API_URL=https://api.test.datacite.org
LA_DATACITE_REPOSITORY_ID=
LA_DATACITE_PASSWORD=
LA_DATACITE_PREFIX=
# Optional ROR IDs for Centre affiliations, e.g. {"rwanda": "https://ror.org/..."}
LA_CENTRE_ROR={}

LA_SESSION_SECRET=replace-with-a-long-random-secret
LA_SESSION_COOKIE_SECURE=false
LA_REPOSITORY_DB_PATH=./data/repository.sqlite3
LA_REPOSITORY_STORAGE_PATH=./data/repository-files
# Used only on first startup to create the initial AIMS administrator.
LA_BOOTSTRAP_ADMIN_EMAIL=
LA_BOOTSTRAP_ADMIN_PASSWORD=
LA_BOOTSTRAP_ADMIN_NAME=AIMS Administrator
